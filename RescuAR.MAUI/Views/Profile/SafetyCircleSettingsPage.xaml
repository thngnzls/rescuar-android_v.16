<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Profile"
    xmlns:views="clr-namespace:RescuAR.App.Views.Profile"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Profile.SafetyCircleSettingsPage"
    x:Name="SafetyCircleSettingsRoot"
    x:DataType="vm:SafetyCircleSettingsViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Bar -->
        <Border Grid.Row="0" BackgroundColor="White" HeightRequest="56" StrokeThickness="0" Padding="12,0" ZIndex="10" Shadow="{Shadow Brush=Black, Offset='0,2', Radius=4, Opacity=0.06}">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Path Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" Fill="#0F172A" Aspect="Uniform" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <Label Text="Back" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Grid.Column="1" Text="RescuAR" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

                <Path Grid.Column="2" Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                      Fill="#334155" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,0,4,0" />
            </Grid>
        </Border>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20,12,20,30">
                <!-- Breadcrumb & Title -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Profile/" FontSize="13" TextColor="#64748B" FontAttributes="Bold" />
                    <Label Text="Safety Circle Management" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Manage circles, invite family members, and switch active emergency channels." FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Active Circle Card (When in a circle) -->
                <Border IsVisible="{Binding IsInCircle}" StrokeShape="RoundRectangle 16" BackgroundColor="#0A8491" StrokeThickness="0" Padding="18" Shadow="{Shadow Brush=Black, Offset='0,3', Radius=8, Opacity=0.1}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" 
                                      Fill="#CCFBF1" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center"/>
                                <Label Text="ACTIVE SAFETY CIRCLE" FontSize="11" TextColor="#CCFBF1" FontAttributes="Bold" VerticalOptions="Center" CharacterSpacing="1" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Label Text="{Binding ActiveCircleName}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                        
                        <!-- Invite Code Box -->
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#08646E" StrokeThickness="1" Stroke="#2DD4BF" Padding="14,10" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="INVITE CODE" FontSize="9.5" TextColor="#99F6E4" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Label Text="{Binding InviteCode}" FontSize="18" FontAttributes="Bold" TextColor="White" CharacterSpacing="2" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="Copy Code"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#0A8491"
                                    BackgroundColor="White"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="14,0"
                                    Command="{Binding CopyInviteCodeCommand}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- All Joined / Created Safety Circles List -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                                      Fill="#0A8491" WidthRequest="18" HeightRequest="18" Aspect="Uniform" VerticalOptions="Center"/>
                                <Label Text="Your Safety Circles" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding AllMyCircles.Count, StringFormat='{0} circles'}" FontSize="12" TextColor="#64748B" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                        <CollectionView ItemsSource="{Binding AllMyCircles}" SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="6" Padding="12" HorizontalOptions="Center">
                                    <Label Text="No safety circles joined yet." FontSize="13" TextColor="#64748B" HorizontalOptions="Center"/>
                                    <Label Text="Create or join a circle below to stay connected." FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SupabaseSafetyCircle">
                                    <Border Margin="0,4" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                            <!-- Circle Badge / Icon -->
                                            <Border Grid.Column="0" BackgroundColor="#E6F4F2" StrokeThickness="0" WidthRequest="38" HeightRequest="38" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                                                      Fill="#0A8491" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <!-- Circle Details -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" TextColor="#0F172A" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding InviteCode, StringFormat='Invite Code: {0}'}" FontSize="11" TextColor="#64748B" />
                                            </VerticalStackLayout>

                                            <!-- Action Controls: Active Status, Photo, Rename, Delete -->
                                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                                <!-- Make Active Button -->
                                                <Button Text="Make Active"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        TextColor="White"
                                                        BackgroundColor="#0A8491"
                                                        CornerRadius="6"
                                                        HeightRequest="32"
                                                        Padding="8,0"
                                                        Command="{Binding ViewModel.SelectActiveCircleCommand, Source={x:Reference SafetyCircleSettingsRoot}, x:DataType=views:SafetyCircleSettingsPage}"
                                                        CommandParameter="{Binding .}"/>

                                                <!-- Photo -->
                                                <Border BackgroundColor="#E0F2FE" StrokeThickness="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ViewModel.UpdateCirclePhotoCommand, Source={x:Reference SafetyCircleSettingsRoot}, x:DataType=views:SafetyCircleSettingsPage}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M4 4h3l2-2h6l2 2h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6z" 
                                                          Fill="#0284C7" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>

                                                <!-- Rename -->
                                                <Border BackgroundColor="#F1F5F9" StrokeThickness="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ViewModel.RenameCircleCommand, Source={x:Reference SafetyCircleSettingsRoot}, x:DataType=views:SafetyCircleSettingsPage}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                                                          Fill="#475569" Aspect="Uniform" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>

                                                <!-- Delete -->
                                                <Border BackgroundColor="#FEE2E2" StrokeThickness="0" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ViewModel.RequestDeleteCircleCommand, Source={x:Reference SafetyCircleSettingsRoot}, x:DataType=views:SafetyCircleSettingsPage}" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                                          Fill="#DC2626" Aspect="Uniform" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Active Circle Members List (When Active Circle Selected) -->
                <Border IsVisible="{Binding IsInCircle}" StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Active Circle Members" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Members.Count, StringFormat='{0} members'}" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                        <CollectionView ItemsSource="{Binding Members}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:User">
                                    <Grid Margin="0,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 16" WidthRequest="32" HeightRequest="32" BackgroundColor="#E0F2FE" VerticalOptions="Center">
                                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" 
                                                  Fill="#0A8491" Aspect="Uniform" WidthRequest="14" HeightRequest="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding FirstName}" FontAttributes="Bold" FontSize="13" TextColor="#0F172A" />
                                                <Label Text="{Binding LastName}" FontAttributes="Bold" FontSize="13" TextColor="#0F172A" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding PhoneNumber, FallbackValue='Safe'}" FontSize="11" TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" BackgroundColor="#16A34A" VerticalOptions="Center"/>
                                            <Label Text="Online" FontSize="11" FontAttributes="Bold" TextColor="#16A34A" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Create Circle Card -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Create a New Circle" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Start a circle for your household or neighborhood group." FontSize="12" TextColor="#64748B" />

                        <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                            <Entry Text="{Binding NewCircleName}" Placeholder="e.g. Santos Family" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalOptions="Center" />
                        </Border>

                        <Button
                            Text="Create Safety Circle"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#0A8491"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding CreateCircleCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Join Circle Card -->
                <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Join an Existing Circle" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                        <Label Text="Enter the 6-character invite code shared by your group admin." FontSize="12" TextColor="#64748B" />

                        <Border StrokeShape="RoundRectangle 10" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0" HeightRequest="46">
                            <Entry Text="{Binding JoinInviteCode}" Placeholder="e.g. A9B2X7" TextColor="#0F172A" PlaceholderColor="#94A3B8" MaxLength="10" CharacterSpacing="2" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" />
                        </Border>

                        <Button
                            Text="Join Circle"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#0A8491"
                            BackgroundColor="#E6F4F5"
                            CornerRadius="10"
                            HeightRequest="44"
                            Command="{Binding JoinCircleCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============================================================== -->
        <!-- CUSTOM STYLED DELETE CONFIRMATION MODAL OVERLAY                -->
        <!-- ============================================================== -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsDeleteModalVisible}"
              ZIndex="120"
              Padding="24">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="24,20"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="400">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#40000000" Offset="0,6" Radius="16" Opacity="0.3" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <!-- Warning Icon -->
                    <Border BackgroundColor="#FEE2E2" StrokeThickness="0" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>
                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                              Fill="#DC2626" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Delete Safety Circle?" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding CircleToDelete.Name, StringFormat='Are you sure you want to remove \x22{0}\x22?'}" FontSize="13" FontAttributes="Bold" TextColor="#DC2626" HorizontalTextAlignment="Center" />
                        <Label Text="You will leave this group and lose access to its member tracking and chat history." FontSize="12.5" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#475569"
                                BackgroundColor="#F1F5F9"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding CancelDeleteCommand}" />

                        <Button Grid.Column="1"
                                Text="Delete Circle"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="#DC2626"
                                CornerRadius="10"
                                HeightRequest="44"
                                Command="{Binding ConfirmDeleteCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

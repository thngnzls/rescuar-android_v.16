<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Authentication"
    x:DataType="vm:SplashViewModel"
    x:Class="RescuAR.App.Views.Authentication.SplashPage"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#0B132B">

    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        
        <!-- Deep Ambient Gradient Background -->
        <BoxView BackgroundColor="#0B132B" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

        <!-- Center Stage Stack -->
        <VerticalStackLayout HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             Spacing="40">
            
            <!-- Radar on Top of Map Display Widget -->
            <Border x:Name="RadarBorder"
                    WidthRequest="270"
                    HeightRequest="270"
                    StrokeThickness="2.5"
                    Stroke="#1E3A5F"
                    StrokeShape="RoundRectangle 135"
                    BackgroundColor="#0D1B36"
                    HorizontalOptions="Center"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#0A8491" Offset="0,0" Radius="36" Opacity="0.55" />
                </Border.Shadow>

                <skia:SKCanvasView x:Name="RadarCanvas"
                                   WidthRequest="270"
                                   HeightRequest="270"
                                   PaintSurface="OnRadarCanvasPaintSurface"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
            </Border>

            <!-- Only RescuAR Brand Text Visible -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                <Label Text="Rescu"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       CharacterSpacing="1.5" />
                <Label Text="AR"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="#0A8491"
                       CharacterSpacing="1.5" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        
    </Grid>

</ContentPage>
